<!-- 설정 창·트레이 메뉴 공용 다크 테마. ai_agent(CliAgent)의 Styles/ModernControls.xaml·App.xaml 토큰을 따른다.
     Win11 Fluent Dark 서피스 + violet accent. 위젯 화면에는 걸지 않도록 창·메뉴 단위로만 병합한다(ModernTheme.cs). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 색 토큰 ===== -->
    <SolidColorBrush x:Key="Bae.Bg"            Color="#202020"/>
    <SolidColorBrush x:Key="Bae.BgAlt"         Color="#1C1C1C"/>
    <SolidColorBrush x:Key="Bae.Surface"       Color="#2B2B2B"/>
    <SolidColorBrush x:Key="Bae.SurfaceAlt"    Color="#323232"/>
    <SolidColorBrush x:Key="Bae.SurfaceHover"  Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Bae.SurfacePress"  Color="#272727"/>
    <SolidColorBrush x:Key="Bae.Border"        Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Bae.BorderHover"   Color="#4A4A4A"/>
    <SolidColorBrush x:Key="Bae.Divider"       Color="#2D2D2D"/>
    <SolidColorBrush x:Key="Bae.Accent"        Color="#C4B5FD"/>
    <SolidColorBrush x:Key="Bae.AccentHover"   Color="#D3C2FF"/>
    <SolidColorBrush x:Key="Bae.AccentPress"   Color="#AC9BEF"/>
    <SolidColorBrush x:Key="Bae.AccentSoft"    Color="#3A3550"/>
    <SolidColorBrush x:Key="Bae.AccentText"    Color="#000000"/>
    <SolidColorBrush x:Key="Bae.TextPrimary"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Bae.TextMuted"     Color="#C7C7C7"/>
    <SolidColorBrush x:Key="Bae.TextDim"       Color="#9A9A9A"/>
    <SolidColorBrush x:Key="Bae.Danger"        Color="#FF99A4"/>
    <SolidColorBrush x:Key="Bae.Success"       Color="#6CCB5F"/>

    <!-- ===== 디자인 토큰 ===== -->
    <CornerRadius x:Key="Bae.CornerRadius.Small">4</CornerRadius>
    <CornerRadius x:Key="Bae.CornerRadius.Medium">6</CornerRadius>
    <FontFamily x:Key="Bae.Font.Ui">Segoe UI Variable Text, Segoe UI, Malgun Gothic</FontFamily>
    <FontFamily x:Key="Bae.Font.Display">Segoe UI Variable Display, Segoe UI, Malgun Gothic</FontFamily>
    <Thickness x:Key="Bae.Button.Padding">14,6</Thickness>

    <!-- ===== 글자 ===== -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Bae.TextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource Bae.Font.Ui}"/>
        <Setter Property="FontSize"   Value="13"/>
    </Style>
    <Style x:Key="Bae.Text.Title" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Bae.TextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource Bae.Font.Display}"/>
        <Setter Property="FontSize"   Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Bae.Text.Subtitle" TargetType="TextBlock">
        <Setter Property="Foreground"   Value="{DynamicResource Bae.TextDim}"/>
        <Setter Property="FontFamily"   Value="{StaticResource Bae.Font.Ui}"/>
        <Setter Property="FontSize"     Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Bae.Text.Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Bae.TextMuted}"/>
        <Setter Property="FontFamily" Value="{StaticResource Bae.Font.Ui}"/>
        <Setter Property="FontSize"   Value="12"/>
    </Style>
    <Style x:Key="Bae.Text.Hint" TargetType="TextBlock">
        <Setter Property="Foreground"   Value="{DynamicResource Bae.TextDim}"/>
        <Setter Property="FontSize"     Value="11"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ===== Button (기본 = 보조, AccentButton 파생) ===== -->
    <ControlTemplate x:Key="Bae.ButtonTemplate" TargetType="Button">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Bae.CornerRadius.Small}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"
                              RecognizesAccessKey="True" SnapsToDevicePixels="True"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource Bae.SurfaceHover}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Bae.BorderHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bae.SurfacePress}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Bae.Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="Button">
        <Setter Property="Background"      Value="{DynamicResource Bae.SurfaceAlt}"/>
        <Setter Property="Foreground"      Value="{DynamicResource Bae.TextPrimary}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Bae.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="{StaticResource Bae.Button.Padding}"/>
        <Setter Property="MinHeight"       Value="32"/>
        <Setter Property="MinWidth"        Value="92"/>
        <Setter Property="FontFamily"      Value="{StaticResource Bae.Font.Ui}"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"        Value="{StaticResource Bae.ButtonTemplate}"/>
    </Style>

    <ControlTemplate x:Key="Bae.AccentButtonTemplate" TargetType="Button">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Bae.CornerRadius.Small}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"
                              RecognizesAccessKey="True" SnapsToDevicePixels="True"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource Bae.AccentHover}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Bae.AccentHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource Bae.AccentPress}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Bae.AccentPress}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background"  Value="{DynamicResource Bae.Accent}"/>
        <Setter Property="Foreground"  Value="{DynamicResource Bae.AccentText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Bae.Accent}"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="Template"    Value="{StaticResource Bae.AccentButtonTemplate}"/>
    </Style>

    <!-- 모니터 배치 그림의 화면 버튼: 선택 상태는 코드에서 Tag="selected"로 표시한다. -->
    <Style x:Key="Bae.MonitorButton" TargetType="Button">
        <Setter Property="Background"      Value="{DynamicResource Bae.SurfaceAlt}"/>
        <Setter Property="Foreground"      Value="{DynamicResource Bae.TextPrimary}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Bae.Border}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Bae.CornerRadius.Medium}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Bae.BorderHover}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="selected">
                            <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource Bae.AccentSoft}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Bae.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== TextBox ===== -->
    <Style TargetType="TextBox">
        <Setter Property="Background"      Value="{DynamicResource Bae.SurfaceAlt}"/>
        <Setter Property="Foreground"      Value="{DynamicResource Bae.TextPrimary}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Bae.Border}"/>
        <Setter Property="CaretBrush"      Value="{DynamicResource Bae.TextPrimary}"/>
        <Setter Property="SelectionBrush"  Value="{DynamicResource Bae.Accent}"/>
        <Setter Property="SelectionOpacity" Value="0.45"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="8,5"/>
        <Setter Property="MinHeight"       Value="30"/>
        <Setter Property="FontFamily"      Value="{StaticResource Bae.Font.Ui}"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Bae.CornerRadius.Small}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Bae.BorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Bae.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== CheckBox ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="Background"      Value="{DynamicResource Bae.SurfaceAlt}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Bae.BorderHover}"/>
        <Setter Property="Foreground"      Value="{DynamicResource Bae.TextPrimary}"/>
        <Setter Property="FontFamily"      Value="{StaticResource Bae.Font.Ui}"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="3" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Path x:Name="Check" Stroke="{DynamicResource Bae.AccentText}" StrokeThickness="2" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 3 9 L 7 13 L 14 5" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Bae.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box"   Property="Background"  Value="{DynamicResource Bae.Accent}"/>
                            <Setter TargetName="Box"   Property="BorderBrush" Value="{DynamicResource Bae.Accent}"/>
                            <Setter TargetName="Check" Property="Visibility"  Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ComboBox ===== -->
    <Style x:Key="Bae.ComboBoxToggleButton" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            CornerRadius="{StaticResource Bae.CornerRadius.Small}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource Bae.TextMuted}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Bae.BorderHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background"      Value="{DynamicResource Bae.SurfaceAlt}"/>
        <Setter Property="Foreground"      Value="{DynamicResource Bae.TextPrimary}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Bae.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="10,6"/>
        <Setter Property="MinHeight"       Value="32"/>
        <Setter Property="FontFamily"      Value="{StaticResource Bae.Font.Ui}"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource Bae.ComboBoxToggleButton}" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          IsHitTestVisible="False"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4,0,0">
                                <Border Background="{DynamicResource Bae.Surface}" BorderBrush="{DynamicResource Bae.Border}"
                                        BorderThickness="1" CornerRadius="{StaticResource Bae.CornerRadius.Small}"/>
                                <ScrollViewer Margin="3">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Bae.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Bae.TextPrimary}"/>
        <Setter Property="Padding"    Value="10,6"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource Bae.CornerRadius.Small}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bae.AccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bae.SurfaceHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ScrollBar (얇은 다크 막대, 화살표 없음, 마우스를 올리면 밝아짐) ===== -->
    <Style x:Key="Bae.ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" Background="{DynamicResource Bae.BorderHover}" CornerRadius="3"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bae.TextDim}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bae.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Bae.ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width"      Value="10"/>
        <Setter Property="MinWidth"   Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}" Padding="2">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Bae.ScrollPage}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Bae.ScrollThumb}" MinHeight="24"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Bae.ScrollPage}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width"     Value="Auto"/>
                <Setter Property="MinWidth"  Value="0"/>
                <Setter Property="Height"    Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}" Padding="2">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Bae.ScrollPage}" Command="ScrollBar.PageLeftCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Bae.ScrollThumb}" MinWidth="24"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Bae.ScrollPage}" Command="ScrollBar.PageRightCommand"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== TabControl (설정 창 탭: 균등 폭 머리글, 고른 탭은 보라 밑줄) ===== -->
    <Style TargetType="TabControl">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{DynamicResource Bae.Divider}" BorderThickness="0,0,0,1">
                            <UniformGrid Rows="1" IsItemsHost="True"/>
                        </Border>
                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0,16,0,0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource Bae.TextDim}"/>
        <Setter Property="FontFamily" Value="{StaticResource Bae.Font.Ui}"/>
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid x:Name="Root" Background="Transparent">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,9,12,10"/>
                        <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Margin="14,0" CornerRadius="1"
                                Background="{DynamicResource Bae.Accent}" Visibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Bae.TextMuted}"/>
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Bae.Surface}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Bae.TextPrimary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 카드·구분선 ===== -->
    <Style x:Key="Bae.Card" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource Bae.Surface}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Bae.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="{StaticResource Bae.CornerRadius.Medium}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="Bae.DividerLine" TargetType="Border">
        <Setter Property="Height"     Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Bae.Divider}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ===== 툴팁(설정 창 ⓘ 설명) ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Bae.SurfaceAlt}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Bae.BorderHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource Bae.TextPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource Bae.Font.Ui}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource Bae.CornerRadius.Small}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 트레이 메뉴 ===== -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background"      Value="{DynamicResource Bae.Surface}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Bae.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="3"/>
        <Setter Property="Foreground"      Value="{DynamicResource Bae.TextPrimary}"/>
        <Setter Property="FontFamily"      Value="{StaticResource Bae.Font.Ui}"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Bae.CornerRadius.Medium}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 하위 메뉴가 있으면 오른쪽 화살표와 펼침 팝업을 보인다. -->
    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Bae.TextPrimary}"/>
        <Setter Property="Padding"    Value="12,7"/>
        <Setter Property="FontFamily" Value="{StaticResource Bae.Font.Ui}"/>
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Bae.CornerRadius.Small}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- 체크 메뉴(IsCheckable)만 왼쪽에 체크 칸을 둔다(편집 창 위젯 켜고 끄기). -->
                                <Grid x:Name="CheckSlot" Width="16" Margin="0,0,10,0" Visibility="Collapsed">
                                    <Path x:Name="CheckMark" Data="M 1 6 L 5 10 L 13 2" Stroke="{DynamicResource Bae.Accent}" StrokeThickness="2"
                                          VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Hidden"/>
                                </Grid>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"/>
                                <Path x:Name="Arrow" Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center"
                                      Data="M 0 0 L 4 4 L 0 8 Z" Fill="{DynamicResource Bae.TextMuted}" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="4" VerticalOffset="-4"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource Bae.Surface}" BorderBrush="{DynamicResource Bae.Border}" BorderThickness="1"
                                    CornerRadius="{StaticResource Bae.CornerRadius.Medium}" Padding="3">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsCheckable" Value="True">
                            <Setter TargetName="CheckSlot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bae.SurfaceHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Bae.TextDim}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 메뉴 안 구분선은 MenuItem.SeparatorStyleKey 로만 바뀐다. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="4,4"/>
        <Setter Property="Background" Value="{DynamicResource Bae.Divider}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
