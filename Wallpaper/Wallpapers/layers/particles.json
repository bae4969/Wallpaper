{
  "description": "범용 입자. shape=bokeh(흐린 원), streak(빗줄기 같은 선), glow(빛 점). 화면 밖으로 나가면 반대편에서 다시 들어온다.",
  "kind": "particles",
  "blend": "add",
  "params": {
    "count": {
      "slot": "instances",
      "default": 100,
      "description": "입자 수"
    },
    "shape": {
      "slot": "P3.w",
      "default": "bokeh",
      "values": {
        "bokeh": 0,
        "streak": 1,
        "glow": 2
      },
      "description": "모양"
    },
    "colorA": {
      "slot": "P0.rgb",
      "default": "#FFFFFF",
      "description": "색 A"
    },
    "weightA": {
      "slot": "P0.a",
      "default": 1,
      "description": "색 A가 뽑힐 비중"
    },
    "colorB": {
      "slot": "P1.rgb",
      "default": "#FFFFFF",
      "description": "색 B"
    },
    "weightB": {
      "slot": "P1.a",
      "default": 0,
      "description": "색 B 비중(0이면 안 씀)"
    },
    "colorC": {
      "slot": "P2.rgb",
      "default": "#FFFFFF",
      "description": "색 C"
    },
    "weightC": {
      "slot": "P2.a",
      "default": 0,
      "description": "색 C 비중"
    },
    "minSize": {
      "slot": "P3.x",
      "default": 4,
      "description": "최소 크기 px(줄기는 굵기)"
    },
    "maxSize": {
      "slot": "P3.y",
      "default": 8,
      "description": "최대 크기 px"
    },
    "opacity": {
      "slot": "P3.z",
      "default": 0.5,
      "description": "불투명도"
    },
    "velocityX": {
      "slot": "P4.x",
      "default": 0,
      "description": "가로 속도(화면 폭/초)"
    },
    "velocityY": {
      "slot": "P4.y",
      "default": 0,
      "description": "세로 속도(영역 높이/초, +는 아래로)"
    },
    "speedJitter": {
      "slot": "P4.z",
      "default": 0,
      "description": "입자마다 속도 편차 0~1"
    },
    "twinkle": {
      "slot": "P4.w",
      "default": 0,
      "description": "밝기 깜박임 0~1"
    },
    "top": {
      "slot": "P5.x",
      "default": 0,
      "description": "입자 영역 위 경계(0=위)"
    },
    "bottom": {
      "slot": "P5.y",
      "default": 1,
      "description": "입자 영역 아래 경계"
    },
    "length": {
      "slot": "P5.z",
      "default": 40,
      "description": "줄기 길이 px(shape=streak)"
    }
  }
}
