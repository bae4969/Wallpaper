{
  "description": "어두운 바탕 위로 가는 평행선 여러 줄이 물결치며 흐른다. 기울기·원근으로 비스듬한 물결이나 멀어지는 물결면을 만든다(알파 혼합 — 아래에 gradient 를 깐다).",
  "kind": "fullscreen",
  "blend": "alpha",
  "params": {
    "colorA": { "slot": "P0.rgb", "default": "#E8ECF2", "description": "선 색 A(왼쪽)" },
    "opacity": { "slot": "P0.a", "default": 0.7, "description": "선 불투명도 0~1" },
    "colorB": { "slot": "P1.rgb", "default": "#8FA6C8", "description": "선 색 B(오른쪽)" },
    "colorBMix": { "slot": "P1.a", "default": 0.8, "description": "색 B 섞임 0~1" },
    "lines": { "slot": "P2.x", "default": 90, "description": "선 밀도(화면 높이당 선 개수)" },
    "thickness": { "slot": "P2.y", "default": 1.0, "description": "선 두께 px(1080p 기준)" },
    "amplitude": { "slot": "P2.z", "default": 0.1, "description": "물결 높이(화면 높이 비율). 물결 폭의 1/3 안팎까지가 자연스럽다(넘으면 선이 접힌다)" },
    "wavelength": { "slot": "P2.w", "default": 0.45, "description": "물결 폭(화면 높이 비율, 클수록 굽이가 크고 완만)" },
    "speed": { "slot": "P3.x", "default": 0.25, "description": "물결 움직임 속도" },
    "angle": { "slot": "P3.y", "default": 0, "description": "선 기울기(도, +면 반시계)" },
    "perspective": { "slot": "P3.z", "default": 0.8, "description": "원근 세기 0~1(0=고른 평행선, 1=지평선이 화면 위 가장자리 가까이)" },
    "depthFade": { "slot": "P3.w", "default": 0.7, "description": "먼 쪽이 어두워지는 정도 0~1" },
    "shading": { "slot": "P4.x", "default": 0.7, "description": "물결 기울기에 따른 빛 결 세기 0~1" },
    "center": { "slot": "P4.y", "default": 0.5, "description": "무늬 세로 위치(0=위, 1=아래)" },
    "drift": { "slot": "P4.z", "default": 0.0, "description": "무늬가 가로로 흘러가는 속도" },
    "band": { "slot": "P4.w", "default": 0, "description": "선을 물결치는 띠(리본)로 모을 때 띠 폭(화면 높이 비율). 0이면 화면 전체" }
  }
}
