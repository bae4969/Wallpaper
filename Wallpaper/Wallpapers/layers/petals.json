{
  "description": "바람에 날리며 떨어지는 납작한 조각(꽃잎·눈송이·낙엽). 흔들림·회전·뒤집힘(3D 텀블링 흉내)과 크기별 원근 속도·흐림을 준다. 화면 밖으로 나가면 반대편에서 다시 들어온다.",
  "kind": "particles",
  "blend": "alpha",
  "params": {
    "count": {
      "slot": "instances",
      "default": 80,
      "description": "조각 수"
    },
    "shape": {
      "slot": "P3.w",
      "default": "petal",
      "values": {
        "petal": 0,
        "snow": 1,
        "leaf": 2
      },
      "description": "모양: petal(끝이 파인 벚꽃잎), snow(부드러운 눈송이), leaf(낙엽)"
    },
    "colorA": {
      "slot": "P0.rgb",
      "default": "#FFC7D9",
      "description": "색 A"
    },
    "weightA": {
      "slot": "P0.a",
      "default": 1,
      "description": "색 A가 뽑힐 비중"
    },
    "colorB": {
      "slot": "P1.rgb",
      "default": "#FFE4EC",
      "description": "색 B"
    },
    "weightB": {
      "slot": "P1.a",
      "default": 0,
      "description": "색 B 비중(0이면 안 씀)"
    },
    "colorC": {
      "slot": "P2.rgb",
      "default": "#F59AB8",
      "description": "색 C"
    },
    "weightC": {
      "slot": "P2.a",
      "default": 0,
      "description": "색 C 비중"
    },
    "minSize": {
      "slot": "P3.x",
      "default": 10,
      "description": "최소 크기 px(1080p 기준, 조각 길이)"
    },
    "maxSize": {
      "slot": "P3.y",
      "default": 28,
      "description": "최대 크기 px"
    },
    "opacity": {
      "slot": "P3.z",
      "default": 0.9,
      "description": "불투명도"
    },
    "wind": {
      "slot": "P4.x",
      "default": 0.03,
      "description": "가로 바람 속도(화면 폭/초, +는 오른쪽)"
    },
    "fallSpeed": {
      "slot": "P4.y",
      "default": 0.06,
      "description": "떨어지는 속도(영역 높이/초)"
    },
    "speedJitter": {
      "slot": "P4.z",
      "default": 0.35,
      "description": "조각마다 속도 편차 0~1"
    },
    "sway": {
      "slot": "P4.w",
      "default": 40,
      "description": "좌우 흔들림 폭 px"
    },
    "swaySpeed": {
      "slot": "P5.w",
      "default": 0.8,
      "description": "좌우 흔들림 빠르기(1초당 라디안 배율)"
    },
    "spin": {
      "slot": "P5.x",
      "default": 0.8,
      "description": "평면 회전 속도(라디안/초, 조각마다 방향·크기가 다르다)"
    },
    "flutter": {
      "slot": "P5.y",
      "default": 1.6,
      "description": "뒤집힘(텀블링) 속도(라디안/초). 0이면 뒤집히지 않는다"
    },
    "depthBlur": {
      "slot": "P5.z",
      "default": 0.5,
      "description": "큰(가까운) 조각일수록 가장자리를 흐리게 하는 정도 0~1"
    },
    "top": {
      "slot": "P6.x",
      "default": 0,
      "description": "영역 위 경계(0=위)"
    },
    "bottom": {
      "slot": "P6.y",
      "default": 1,
      "description": "영역 아래 경계"
    },
    "gust": {
      "slot": "P6.z",
      "default": 0.4,
      "description": "돌풍: 바람 세기가 천천히 오르내리는 정도 0~1"
    },
    "parallax": {
      "slot": "P6.w",
      "default": 0.6,
      "description": "원근 속도: 큰 조각일수록 빨리 움직이는 정도 0~1"
    },
    "stretch": {
      "slot": "P7.x",
      "default": 1,
      "description": "움직이는 방향으로 늘이는 배율(1=그대로, 2~4면 빠른 눈보라의 잔상처럼 보인다)"
    }
  }
}
