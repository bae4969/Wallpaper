      "slot": "P0.rgb",
      "default": "#B0C8E0",
      "description": "물 색조"
    },
    "reflectivity": {
      "slot": "P0.a",
      "default": 0.75,
      "description": "반사 밝기 0~1"
    },
    "ripple": {
      "slot": "P1.x",
      "default": 10,
      "description": "물결 일렁임 폭 px(1080p 기준)"
    },
    "wavelength": {
      "slot": "P1.y",
      "default": 24,
      "description": "물결 크기 px(1080p 기준)"
    },
    "speed": {
      "slot": "P1.z",
      "default": 0.6,
      "description": "물결 속도"
    },
    "blur": {
      "slot": "P1.w",
      "default": 1.2,
      "description": "반사 흐림(mip 단계)"
    },
    "sparkle": {
      "slot": "P2.x",
      "default": 0.4,
      "description": "물결 반짝임 세기 0~1"
